# ================================
# God's Gift - Main .gitignore
# ================================

# ----- Dependencies -----
node_modules/
.pnp/
.pnp.js

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.eggs/
*.egg-info/
*.egg
.mypy_cache/
.pytest_cache/

# ----- Environment Variables -----
.env
.env.local
.env.*.local
*.local.env

# ----- IDE & Editor -----
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ----- OS Generated -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- Expo & React Native -----
.expo/
dist/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# ----- Android -----
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/build/
frontend/android/local.properties
*.apk
*.aab
*.hprof

# ----- iOS -----
frontend/ios/Pods/
frontend/ios/build/
*.ipa
*.xcworkspace
!*.xcworkspace/contents.xcworkspacedata
*.xcuserstate

# ----- Build & Logs -----
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ----- Test & Coverage -----
coverage/
.nyc_output/
htmlcov/

# ----- Misc -----
*.bak
*.tmp
*.temp
.cache/
